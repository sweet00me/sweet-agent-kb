DEEPSEEK_API_KEY=replace_with_your_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 文档集合 Map 分析的独立云端授权，默认关闭；还需显式 authorized=True。
DOCUMENT_ANALYSIS_ALLOW_DEEPSEEK=0
# 实体关联和证据归纳分别授权；各自还需注入辅助器并显式 authorized=True。
DOCUMENT_ANALYSIS_ALLOW_ENTITY_LLM=0
DOCUMENT_ANALYSIS_ALLOW_REDUCE_LLM=0
# 完整集合工作流和语义核验各自单独授权，不能用现有 Map/Agent API Key 代替。
DOCUMENT_ANALYSIS_ALLOW_WORKFLOW_LLM=0
DOCUMENT_ANALYSIS_ALLOW_VERIFICATION_LLM=0

# 集合分析共享预算：发请求前落盘，失败/中断也占用额度，恢复不会重置。
DOCUMENT_ANALYSIS_MAX_CLOUD_CALLS=64
DOCUMENT_ANALYSIS_MAX_RESERVED_TOKENS=2000000
DOCUMENT_ANALYSIS_MAX_REQUEST_BYTES=200000
DOCUMENT_ANALYSIS_REQUEST_TIMEOUT_SECONDS=45
DOCUMENT_ANALYSIS_MAX_VERIFICATION_TARGETS=10000

# 完整输入估算达到 900,000 Token 才摘要；正常压缩到 650,000 Token 以下。
AGENT_CONTEXT_TRIGGER_TOKENS=900000
AGENT_CONTEXT_TARGET_TOKENS=650000
AGENT_MAX_OUTPUT_TOKENS=32768
AGENT_SUMMARY_MAX_TOKENS=4096
AGENT_SUMMARY_BATCH_TOKENS=65536
# 先运行 python -m app.memory.context_budget --install-tokenizer；默认使用用户缓存。
# DEEPSEEK_TOKENIZER_PATH=/path/to/pinned/tokenizer.json

# API 启动后立即同步一次，其后每轮结束等待 24 小时；ENABLED=0 可关闭。
RAG_AUTO_SYNC_ENABLED=1
RAG_AUTO_SYNC_INTERVAL_SECONDS=86400
